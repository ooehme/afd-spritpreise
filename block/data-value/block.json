{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "afd-spritpreise/data-value",
  "version": "1.2.4",
  "title": "Spritpreise – Datenwert",
  "category": "widgets",
  "icon": "database",
  "description": "Ein einzelner dynamischer Wert aus dem AfD-Spritpreise-Datenkontext.",
  "textdomain": "afd-spritpreise",
  "ancestor": ["afd-spritpreise/fuel-price", "afd-spritpreise/fuel-price-compact"],
  "attributes": {
    "field": { "type": "string", "default": "current" },
    "tagName": { "type": "string", "default": "div" }
  },
  "usesContext": ["afdsp/minLat", "afdsp/minLng", "afdsp/maxLat", "afdsp/maxLng", "afdsp/areaLabel", "afdsp/defaultFuel"],
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "ariaLabel": true,
    "html": false,
    "color": { "background": true, "text": true, "link": true, "gradients": true },
    "shadow": true,
    "spacing": { "margin": true, "padding": true },
    "dimensions": { "minHeight": true, "minWidth": true },
    "__experimentalBorder": { "color": true, "radius": true, "style": true, "width": true },
    "position": { "sticky": true },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true
    }
  },
  "editorScript": "afdsp-block-editor",
  "style": "afdsp-frontend"
}
