{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "afd-spritpreise/fuel-tab",
  "version": "1.2.4",
  "title": "Spritpreise – Kraftstoff-Tab",
  "category": "widgets",
  "icon": "button",
  "textdomain": "afd-spritpreise",
  "parent": ["afd-spritpreise/fuel-tabs"],
  "attributes": {
    "fuel": { "type": "string", "default": "diesel" },
    "label": { "type": "string", "default": "Diesel" }
  },
  "usesContext": ["afdsp/defaultFuel"],
  "supports": {
    "anchor": true,
    "html": false,
    "spacing": { "margin": true }
  },
  "editorScript": "afdsp-block-editor",
  "style": ["afdsp-frontend", "file:./style.css"]
}
