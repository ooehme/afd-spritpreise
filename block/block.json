{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "afd-spritpreise/fuel-price",
  "version": "1.0.0",
  "title": "AfD Spritpreise",
  "category": "widgets",
  "icon": "money-alt",
  "description": "Regionale Kraftstoffpreise und AfD-Steuerszenario.",
  "textdomain": "afd-spritpreise",
  "attributes": {
    "minLat": { "type": "number" },
    "minLng": { "type": "number" },
    "maxLat": { "type": "number" },
    "maxLng": { "type": "number" },
    "areaLabel": { "type": "string" },
    "defaultFuel": { "type": "string" },
    "displayMode": { "type": "string" },
    "showTitle": { "type": "boolean" },
    "showDemands": { "type": "boolean" },
    "showMethod": { "type": "boolean" },
    "showCheapestStation": { "type": "boolean" },
    "showTankSaving": { "type": "boolean" },
    "showDetailsLink": { "type": "boolean" }
  },
  "supports": {
    "align": ["wide", "full"],
    "html": false
  },
  "editorScript": "afdsp-block-editor",
  "editorStyle": "afdsp-admin",
  "style": "afdsp-frontend"
}
