{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "afd-spritpreise/fuel-tabs",
  "version": "1.2.4",
  "title": "Spritpreise – Kraftstoffauswahl",
  "category": "widgets",
  "icon": "controls-repeat",
  "textdomain": "afd-spritpreise",
  "ancestor": ["afd-spritpreise/fuel-price", "afd-spritpreise/fuel-price-compact"],
  "usesContext": ["afdsp/defaultFuel"],
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "ariaLabel": true,
    "html": false,
    "color": { "background": true, "text": true, "gradients": true },
    "shadow": true,
    "spacing": { "margin": true, "padding": true, "blockGap": true },
    "dimensions": { "minHeight": true, "minWidth": true },
    "__experimentalBorder": { "color": true, "radius": true, "style": true, "width": true },
    "position": { "sticky": true },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true
    }
  },
  "editorScript": "afdsp-block-editor",
  "style": "afdsp-frontend"
}
