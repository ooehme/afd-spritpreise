{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "afd-spritpreise/metric",
  "version": "1.1.0",
  "title": "Spritpreise – Preisfeld",
  "category": "widgets",
  "icon": "money-alt",
  "textdomain": "afd-spritpreise",
  "parent": ["afd-spritpreise/price-board"],
  "attributes": {
    "metric": { "type": "string", "default": "current" },
    "label": { "type": "string" },
    "fontFamily": { "type": "string" },
    "fontWeight": { "type": "string" }
  },
  "usesContext": ["afdsp/minLat", "afdsp/minLng", "afdsp/maxLat", "afdsp/maxLng", "afdsp/areaLabel", "afdsp/defaultFuel"],
  "supports": {
    "color": { "background": true, "text": true, "gradients": true },
    "spacing": { "margin": true, "padding": true },
    "typography": { "fontSize": true, "lineHeight": true, "textAlign": true },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "shadow": true,
    "html": false
  },
  "editorScript": "afdsp-block-editor",
  "style": "afdsp-frontend"
}
